# Copy to .env and fill in. NEVER commit .env. Placeholders only below.

# --- Database ---------------------------------------------------------------
DB_NAME=netmon
DB_USERNAME=netmon
# Generate: openssl rand -base64 24
DB_PASSWORD=change-me-strong-db-password

# --- Authentication ---------------------------------------------------------
# REQUIRED. At least 32 random bytes, base64. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
# ISO-8601 durations
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=PT8H
# Keep true whenever the UI is served over HTTPS (production). Set false ONLY for
# plain-HTTP local testing, otherwise the browser drops the refresh cookie.
REFRESH_COOKIE_SECURE=true
# LAB ONLY: true turns the password policy off (any non-empty password, e.g. "123").
# Never set it on a real deployment; Platform health shows a warning while it is on.
# LAB_WEAK_PASSWORDS=false

# --- First-run setup --------------------------------------------------------
# Optional one-time token to create the first SUPER_ADMIN (min 24 chars).
# Leave empty to have the backend generate one and print it in its log.
BOOTSTRAP_SETUP_TOKEN=

# --- Web ---------------------------------------------------------------------
# Interface and port the UI is published on. 127.0.0.1 = this machine only.
HTTP_BIND=127.0.0.1
HTTP_PORT=8088

# --- Monitoring agents (phase 2) -------------------------------------------
# Address agents use to reach this platform (shown in the install command), e.g.
# https://netmon.mot.gov.af . Leave empty to use the address in the browser.
AGENT_PUBLIC_URL=
# How long raw samples and 5-minute averages are kept (ISO-8601 durations).
METRICS_RAW_RETENTION=P7D
METRICS_ROLLUP_RETENTION=P90D

# --- Packet captures (phase 4) ----------------------------------------------
# Total disk space all stored capture files may use (bytes). Default 10 GB.
CAPTURE_STORAGE_QUOTA_BYTES=10737418240
# Upper limits a user may request for one capture.
CAPTURE_MAX_DURATION_SECONDS=3600
CAPTURE_MAX_BYTES=1073741824
# Capture files are deleted automatically after this many days (users may pick up to the max).
CAPTURE_DEFAULT_RETENTION_DAYS=7
CAPTURE_MAX_RETENTION_DAYS=90

# --- Events and alerts (phase 5) --------------------------------------------
# Timeline events are deleted after this period; resolved alerts after the second.
EVENTS_RETENTION=P180D
ALERTS_RESOLVED_RETENTION=P365D
# Flood protection: at most this many events per server per hour (the overflow is recorded once).
EVENTS_MAX_PER_SERVER_PER_HOUR=600
# How often alert rules are evaluated.
ALERT_EVALUATION_INTERVAL=PT1M

# --- Flow collector (phase 6) ------------------------------------------------
# NetFlow v5/v9 and IPFIX from registered network devices. Off by default.
FLOW_COLLECTOR_ENABLED=false
# Host address the UDP ports are published on: use the management-network address of this host.
FLOW_BIND=127.0.0.1
FLOW_NETFLOW_PORT=2055
FLOW_IPFIX_PORT=4739
# Per exporter; extra records are dropped and counted on the device page.
FLOW_MAX_PER_SECOND=20000
FLOWS_RETENTION=P14D

# --- Misc --------------------------------------------------------------------
# Swagger UI at /swagger-ui.html (backend). Keep false in production.
API_DOCS_ENABLED=false
# "ecs" or "logstash" for JSON logs, empty for plain text.
LOG_FORMAT=

# --- Firewall and IP access control (Phase 7). See docs/FIREWALL.md ---
# Addresses no firewall rule may ever block (management/monitoring networks, jump hosts, this platform).
FIREWALL_PROTECTED_CIDRS=127.0.0.0/8,::1/128
# An approved rule the agent does not confirm within this time is marked FAILED.
FIREWALL_TASK_TIMEOUT=PT1H

# --- Operations (Phase 9). See docs/DEPLOYMENT.md ---
# Memory limit of the backend container (the JVM uses at most 75% of it).
BACKEND_MEMORY=2g
