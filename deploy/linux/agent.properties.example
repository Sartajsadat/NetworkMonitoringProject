# /etc/netmon-agent/agent.properties  (owner root, mode 0644; contains no secrets)

# Address of the central platform. HTTPS is required (plain http only for localhost or with
# tls.allow-insecure-http=true in an isolated lab).
platform.url=https://netmon.example.gov.af

# PEM file of the ministry CA that signed the platform's TLS certificate (leave empty to use
# the Java default trust store).
tls.ca-certificate=

# Where the agent keeps its credential (credentials.json, mode 0600).
state.dir=/var/lib/netmon-agent

# How many reports to keep in memory while the platform is unreachable (240 x 30 s = 2 hours).
buffer.max-reports=240

# The agent rotates its own credential after this many days.
credentials.rotate-after-days=30

# Path of systemctl (used only for "systemctl show <unit>" on platform-approved unit names).
systemctl.path=/usr/bin/systemctl

# --- Packet capture (Phase 4). OFF unless enabled here by this server's administrator. ---
# Use deploy/linux/enable-capture.sh: it also gives dumpcap its capture permission.
capture.enabled=false
# Interfaces the platform may capture on (comma separated). Empty = every real interface.
capture.interfaces=
# Local upper limits; the platform can never request more.
capture.max-duration-seconds=3600
capture.max-megabytes=1024
capture.dumpcap-path=/usr/bin/dumpcap
# Pieces wait here until uploaded (then deleted). Capture stops if free space drops below the minimum.
#capture.spool-dir=/var/lib/netmon-agent/captures
capture.min-free-disk-megabytes=512

# --- Firewall control (Phase 7). OFF unless enabled here by this server's administrator. ---
# Use deploy/linux/enable-firewall.sh: it also gives the agent the permission it needs.
# firewall.enabled=true      the agent reports the firewall and CHECKS approved rules (dry run).
# firewall.enforcement=true  the agent may also really change the firewall. Leave false until the
#                            integration was tested in a lab and an administrator approved it.
firewall.enabled=false
firewall.enforcement=false
# auto = UFW if UFW is enabled, otherwise nftables (own table "inet netmon"); firewalld is not supported.
firewall.backend=auto
firewall.nft-path=/usr/sbin/nft
firewall.ufw-path=/usr/sbin/ufw
firewall.sudo-path=/usr/bin/sudo
# Addresses that must never be blocked here, besides loopback and the platform (comma separated CIDRs),
# e.g. the jump host and the monitoring network.
firewall.protected-addresses=
# Connections to these local ports are never cut: their remote addresses are protected while connected.
firewall.management-ports=22,3389,5985,5986
