# C:\ProgramData\NetMon\Agent\agent.properties  (written by install-agent.ps1; contains no secrets)
# Use forward slashes in paths.

platform.url=https://netmon.example.gov.af

# PEM file of the ministry CA, if the platform certificate is not trusted by Java by default.
tls.ca-certificate=C:/ProgramData/NetMon/Agent/ca.pem

state.dir=C:/ProgramData/NetMon/Agent/state
buffer.max-reports=240
credentials.rotate-after-days=30

# Windows PowerShell used for the read-only data query (default shown).
powershell.path=C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe

# --- Packet capture (Phase 4). OFF unless enabled here (install-agent.ps1 -EnableCapture). ---
# Needs Wireshark (dumpcap.exe) and Npcap. Interfaces may be given by name or by the
# description shown by dumpcap -D, e.g. Ethernet0. Empty = every real interface.
capture.enabled=false
capture.interfaces=
capture.max-duration-seconds=3600
capture.max-megabytes=1024
capture.dumpcap-path=C:/Program Files/Wireshark/dumpcap.exe
capture.min-free-disk-megabytes=512

# --- Firewall control (Phase 7). OFF unless enabled here by this server's administrator. ---
# Needs the agent service to run as LocalSystem (install-agent.ps1 -EnableFirewall).
# firewall.enabled=true      the agent reports Windows Defender Firewall and CHECKS approved rules (-WhatIf).
# firewall.enforcement=true  the agent may also create rules (group "NetMon"). Leave false until the
#                            integration was tested in a lab and an administrator approved it.
firewall.enabled=false
firewall.enforcement=false
# Addresses that must never be blocked here, besides loopback and the platform (comma separated CIDRs).
firewall.protected-addresses=
firewall.management-ports=22,3389,5985,5986
